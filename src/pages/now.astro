---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<Layout title="Now — platte.dev">
  <Breadcrumbs parts={[{ label: '~', href: '/' }, { label: 'now' }]} />
  <div class="mx-auto mt-[18px] max-w-[var(--max-page)] px-6">
    <h1 class="my-[18px] mb-1.5 font-serif text-[48px] font-normal tracking-[-0.02em]">Now</h1>
    <p class="m-0 mb-8 font-mono text-[13px] text-fg-3">
      Last updated: May 1, 2026 · <a href="https://nownownow.com" class="text-fg-3">what is this?</a>
    </p>

    <div class="prose">
      <p class="lede">
        What I'm working on, reading, and otherwise giving my time to, this month.
      </p>

      <h3 class="mt-8 font-serif text-[24px] font-normal">Working on</h3>
      <ul>
        <li>Generative AI evaluations at HubSpot.</li>
        <li>A "Learn to sing in the car" mobile app — free, no ads, ever.</li>
        <li>A blog post on testability as a code smell.</li>
      </ul>

      <h3 class="mt-8 font-serif text-[24px] font-normal">Reading</h3>
      <ul>
        <li><em>Carpe Jugulum</em> — Discworld, my favorite series by my favorite author.</li>
        <li><em>Designing Data-Intensive Applications</em> — again.</li>
      </ul>

      <h3 class="mt-8 font-serif text-[24px] font-normal">Everything else</h3>
      <ul>
        <li>Being a dad.</li>
      </ul>

      <hr />
      <p class="text-[14px] text-fg-3">
        This page is a <a href="https://nownownow.com">Now page</a> — not a status feed,
        not a journal, just where I am this month. I update it when it
        stops being true.
      </p>
    </div>
  </div>
</Layout>
